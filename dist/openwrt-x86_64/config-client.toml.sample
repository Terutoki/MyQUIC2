# MyQUIC2 client config
socks_listen = "[::]:1080"
server_addr = "127.0.0.1:8443"
server_name = "test.com"
server_cert_file = "server-cert.pem"
congestion = "bbr"
gso = true
keep_alive_secs = 5
reconnect_timeout_secs = 5
# Address family tried first for DNS results, incl. the server_addr lookup:
# "ipv6" (default) or "ipv4".
dns_ip_preference = "ipv6"
# Must match the server's auth_token (empty on both sides = no auth).
# Set a private random shared secret here and on the server.
# Empty on BOTH sides disables auth (firewall isolation only).
auth_token = ""
# Low-memory preset for a 200M/140ms link (shipped default is 4/8/4 MB): 2/4/2 MB
# windows + 4 TCP connections (plus the dedicated UDP connections). Single-thread
# caps at ~114M; multi-thread still fills 200M with loaded ping ~= 150-160ms.
stream_receive_window_mb = 2
receive_window_mb = 4
send_window_mb = 2
ack_threshold = 2
max_ack_delay_ms = 5
# Transport tuning (all optional; omit = 4/8/4 MB windows, ACK 2/5ms).
# For ~240 Mb/s use 4/8/4 MB; for 300 Mb/s peak use 8/16/8 MB at ~4x loaded latency; ack_threshold=8 +
# max_ack_delay_ms=10 saves reverse-path CPU at coarser RTT feedback.
# Connection isolation (optional; omit = 4 TCP connections, the code default).
# quic_conns=4 spreads bulk TCP round-robin across three bulk cwnds while
# interactive_ports pin to the first. UDP is never one of those slots: it gets
# its own dedicated connections past the TCP range (interactive + bulk shards),
# so TCP and UDP never share a congestion window or a packet. 1 restores the
# legacy single shared TCP connection (UDP stays separate); clamped to 1..=16.
quic_conns = 4
# UDP egress policy while its dedicated connection reconnects. true (default)
# drops the datagram (counted in the 60s "udp budget" line) rather than sharing
# a TCP connection; false lets it fail over to the other UDP connections first
# and then the TCP pool.
# udp_fail_closed = true
# Split UDP egress into dedicated connections by class (default true):
# interactive_ports destinations and flows whose first datagram is <= 512 B
# (STUN/DTLS/RTP-sized media, DNS, games) ride the interactive connection,
# everything else the bulk one, so a bulk flow cannot starve a
# latency-sensitive flow. false = one shared UDP connection (one fewer dial).
# udp_split = true
# Number of dedicated **bulk** UDP connections (default 2, clamped 1..=8).
# Every bulk association is bound to one shard for life, so N associations
# spread over min(N, k) connections on both ends — k client send/encrypt
# pipelines and k server-side DATAGRAM readers instead of one. Raise toward
# half the cores on many-core hosts; 1 restores the single bulk connection.
# Ignored with udp_split = false.
# udp_egress_conns = 2
# interactive_ports = [53, 123, 3478, 3479, 3480, 3481]
# Max concurrent UDP associations (default 4032, clamped 1..=4032). Each
# association owns a relay socket whose kernel buffer caps dominate its cost
# (~256 KiB on Linux after the kernel's SO_*BUF doubling) plus an ~8.3 KiB
# userspace reader buffer, so a RAM-tight router lowers this; past the cap a
# UDP ASSOCIATE is refused with SOCKS REP=0x01.
# max_udp_assocs = 4032
# ALPN (optional; omit = h3 masquerade). Hides only the ALPN label
# (cert+MQP framing stay fingerprintable). alpn="myquic2/3" restores the
# versioned identifier; set the same value on both sides.
# alpn = "h3"
# ---- TCP/UDP forward listeners (optional; omit both = SOCKS5 only) ----
# Expose a local port that relays raw TCP/UDP through the same QUIC tunnel to a
# fixed destination — for applications that cannot speak SOCKS5. The server
# needs no configuration change; a private/loopback target requires the
# server's allow_private = true, and a non-loopback listen means any host that
# can reach it can use this tunnel, so keep it on 127.0.0.1 or firewall it.
# Up to 256 listeners per protocol. A bad entry (missing/zero port, unspecified
# target, overlapping listener) fails startup before any socket is created.
#
# Forwarding has its own process-wide budgets so it cannot deny the SOCKS5
# endpoint: both default to 3/4 of the shared SOCKS limit, leaving SOCKS at
# least 1/4. These are top-level keys; write them before the [[table]]s.
# Raising either up to the full shared cap (8192 / 4032) deliberately removes
# the SOCKS reserve; the default is the largest value that still leaves the
# >= 1/4 reserve.
# max_forward_conns = 6144        # all tcp_forward connections; 3/4 of 8192
# max_forward_sessions = 3024     # all udp_forward peers; 3/4 of max_udp_assocs
#
# TCP: one accepted connection -> one QUIC bidi stream (half-close and idle
# semantics match SOCKS CONNECT). Admission: per-listener max_conns -> the
# process-wide max_forward_conns -> the shared 8192 TCP relay permits; a
# refusal is an RST. Unset max_conns = the process-wide budget (6144 default).
# [[tcp_forward]]
# listen = "127.0.0.1:8080"
# target = "example.com:80"
# max_conns = 2048
#
# UDP: each client source IP:port gets its own session (180 s idle reap);
# replies are delivered as raw payloads. Admission: per-listener max_sessions
# -> the process-wide max_forward_sessions -> the shared 4032-session hub; when
# a level refuses a new source the listener first evicts its own oldest peer
# idle >= 5 s and retries once. Unset max_sessions = the process-wide budget
# (3024).
#
# Each peer also costs one full server-side session (~288 KiB Linux worst-case
# admission charge; server pool 8192 with a 1024..4096 per-connection fair
# share), so size these limits against the server pool too. Sustained new-peer
# churn above budget/180 s keeps the budget full even though peers are
# short-lived: lower max_sessions to protect SOCKS, but raise
# max_forward_sessions only deliberately (it eats the SOCKS reserve). A
# wildcard listen replies from a route-chosen source address, so bind a
# concrete address for UDP peers that validate the reply source.
# [[udp_forward]]
# listen = "127.0.0.1:5353"
# target = "1.1.1.1:53"
# max_sessions = 1024
