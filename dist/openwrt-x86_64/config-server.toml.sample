# MyQUIC2 server config
listen = "[::]:8443"
# Ingress endpoints: QUIC sockets sharing `listen` through SO_REUSEPORT, each
# with its own receive loop, CID table and accept path. Default: one per usable
# core on Linux, where the kernel spreads a connection's packets across the
# group by 4-tuple; 1 on other platforms (macOS delivers a REUSEPORT group to a
# single member, so extra endpoints there only cost sockets — the server warns
# when you ask for them anyway). Set 1 for the strict single socket.
# Trade-off: a member is pinned by the client's 4-tuple, so a client NAT rebind
# loses the connection (it redials) instead of migrating. Clamped to 1..=8.
# quic_endpoints = 4
cert_file = "server-cert.pem"
key_file = "server-key.pem"
server_name = "test.com"
congestion = "bbr"
gso = true
keep_alive_secs = 5
allow_private = true
# Full-cone NAT semantics for the UDP relay (default false). When true, every
# UDP association's relay socket forwards replies from ANY source, not just the
# hosts that association has sent to, so the client app gets a public UDP
# endpoint that peers can initiate to (P2P games / WebRTC). This exposes that
# app's endpoint to unsolicited internet traffic — unsolicited datagrams are
# outside the auth_token boundary — and it only works if the server's ephemeral
# relay UDP ports are reachable through this host's firewall/NAT. There is no
# per-session inbound rate limit in this mode, and inbound traffic keeps the
# association alive. With allow_private = true above, an unsolicited or
# spoofed sender can also steer app replies toward private/loopback targets,
# so keep allow_private = false on public/multi-user servers.
# udp_full_cone = false
# Address family tried first for resolved targets: "ipv6" (default) or "ipv4".
dns_ip_preference = "ipv6"
# Shared secret clients must present (set on both sides).
# Leave empty to disable auth (then rely on firewall/network isolation).
auth_token = ""
# Admission (optional). Unset max_connections = 4096 with a token above, 256
# without one: a tokenless endpoint admits every peer, so its connection budget
# *is* the pre-auth budget. max_peer_memory_mb caps the peer-pinnable memory the
# admitted connections may represent: the fixed process-wide terms (session pool
# ~2.06 GiB Linux at the shipped 64 KiB buffers, endpoint buffers ~19 MiB per
# quic_endpoint, TCP pump buffers ~512 MiB) are charged once, then the remainder
# is divided by connections x (receive window + send budget + 2 x 1 MB DATAGRAM
# buffers) = 14.25 MiB with the 4/8/4 MB windows below, so raising the windows
# admits fewer connections instead of multiplying the ceiling. Both are logged
# at startup, with the worst-case footprint.
# max_connections = 4096
# max_peer_memory_mb = 128
# Latency-first preset for a 200M/140ms link (mirrors the client: download
# is capped by the receiver's window, upload by the sender's).
stream_receive_window_mb = 2
receive_window_mb = 4
send_window_mb = 2
ack_threshold = 2
max_ack_delay_ms = 5
# Transport tuning (all optional; omit = 4/8/4 MB windows, ACK 2/5ms).
# Must mirror the client's intent: download is capped by the receiver's
# window, upload by the sender's, so change both sides together.
# ALPN (optional; omit = h3 masquerade). Must match the client;
# alpn="myquic2/3" restores the versioned identifier + skew fail-closed guard.
# alpn = "h3"
