# MyQUIC2 server config
listen = "[::]:8443"
cert_file = "server-cert.pem"
key_file = "server-key.pem"
server_name = "test.com"
congestion = "bbr"
gso = true
keep_alive_secs = 5
allow_private = true
# Shared secret clients must present (set on both sides).
# Leave empty to disable auth (then rely on firewall/network isolation).
auth_token = ""
