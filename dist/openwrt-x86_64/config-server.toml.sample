# MyQUIC2 server config
listen = "[::]:8443"
cert_file = "server-cert.pem"
key_file = "server-key.pem"
server_name = "test.com"
congestion = "bbr"
gso = true
keep_alive_secs = 5
allow_private = true
# Shared secret clients must present (set on both sides).
# Leave empty to disable auth (then rely on firewall/network isolation).
auth_token = ""
# Latency-first preset for a 200M/140ms link (mirrors the client: download
# is capped by the receiver's window, upload by the sender's).
stream_receive_window_mb = 2
receive_window_mb = 4
send_window_mb = 2
ack_threshold = 2
max_ack_delay_ms = 5
# Transport tuning (all optional; omit = 2/4/2 MB windows, ACK 2/5ms).
# Must mirror the client's intent: download is capped by the receiver's
# window, upload by the sender's, so change both sides together.
# ALPN (optional; omit = h3 masquerade). Must match the client;
# alpn="myquic2/2" restores the versioned identifier + skew fail-closed guard.
# alpn = "h3"
